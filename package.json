{
  "name": "eirehome-flow",
  "private": true,
  "type": "module",
  "description": "ÉireHome Flow: a guide for first-time home buyers in Ireland.",
  "engines": {
    "node": ">=20.1"
  },
  "scripts": {
    "start": "node tools/serve.js",
    "test": "node --test",
    "lint": "eslint .",
    "check:versions": "node tools/check-versions.js",
    "bump": "node tools/bump-version.js",
    "partials": "node tools/stamp-partials.js",
    "check:partials": "node tools/stamp-partials.js --check",
    "i18n": "node tools/stamp-i18n.js",
    "check:i18n": "node tools/check-i18n.js",
    "posts": "node tools/stamp-posts.js",
    "check:posts": "node tools/stamp-posts.js --check",
    "check": "npm run lint && npm test && npm run check:versions && npm run check:partials && npm run check:posts && npm run check:i18n"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  }
}
